# ────────────────────────────────────────────────────────────────────────────
#  LingkodHub — Environment Variables
#  Copy this file to .env and fill in the values before starting the server.
# ────────────────────────────────────────────────────────────────────────────

# REQUIRED — JWT signing secret. Use a long, random string (32+ chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="CHANGE_ME_USE_A_LONG_RANDOM_SECRET"

# OPTIONAL — Port the Express server listens on. Defaults to 3000.
PORT=3000

# OPTIONAL — Public URL of the app (used for CORS origin whitelisting in production).
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="https://your-app-domain.com"

# OPTIONAL — Gemini AI API key (for any AI features).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
